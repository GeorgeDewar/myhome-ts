{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/myhome.schema.json",
  "title": "House",
  "description": "A house",
  "type": "object",
  "unevaluatedProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "levels"],
        "unevaluatedProperties": false,
        "properties": {
          "name": { "type": "string" },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["number", "name"],
              "unevaluatedProperties": false,
              "properties": {
                "number": { "type": "integer", "description": "Floor number, starting from 0 for the ground floor" },
                "name": { "type": "string", "description": "Displayable name of the floor" },
                "ceilingHeight": {
                  "type": "number",
                  "description": "Height of the ceiling in millimetres, from the unfinished floor surface to the ceiling surface above"
                },
                "totalHeight": {
                  "type": "number",
                  "description": "Height of the floor in millimetres, from the unfinished floor surface to the unfinished floor surface above"
                },
                "walls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "start", "end"],
                    "unevaluatedProperties": false,
                    "properties": {
                      "id": { "type": "string" },
                      "start": {
                        "$ref": "#/$defs/position",
                        "description": "Position of the start of the wall (left side when viewing face A) relative to the floor, in millimetres. The position is midway through the thickness of the wall."
                      },
                      "end": {
                        "$ref": "#/$defs/position",
                        "description": "Position of the end of the wall (right side when viewing face A) relative to the floor, in millimetres. The position is midway through the thickness of the wall."
                      },
                      "width": { "type": "number", "description": "Width of the wall in millimetres" },
                      "openings": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "width", "distanceAlongWall"],
                          "unevaluatedProperties": false,
                          "properties": {
                            "id": { "type": "string" },
                            "width": {
                              "type": "number",
                              "description": "Width of the door (the opening) in millimetres"
                            },
                            "height": {
                              "type": "number",
                              "description": "Height of the door (the opening) in millimetres"
                            },
                            "distanceAlongWall": {
                              "type": "number",
                              "description": "Position of the center of the door along the wall, in millimetres. The position is measured from the start of the wall."
                            },
                            "distanceFromFloor": {
                              "type": "number",
                              "description": "Distance of the bottom of the door from the floor, in millimetres.",
                              "default": 0
                            },
                            "contents": {
                              "type": "array",
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "required": ["type", "hingeSide", "swingDirection"],
                                    "unevaluatedProperties": false,
                                    "properties": {
                                      "type": { "const": "StandardDoor" },
                                      "hingeSide": {
                                        "type": "string",
                                        "enum": ["left", "right"],
                                        "description": "Which side of the door is hinged, as viewed from the A-side of the wall the door is installed in"
                                      },
                                      "swingDirection": {
                                        "type": "string",
                                        "enum": ["in", "out"],
                                        "description": "Direction the door swings when opening, viewed from the A-side of the wall the door is installed in (in being toward the observer)"
                                      },
                                      "thickness": {
                                        "type": "number",
                                        "description": "Thickness of the door leaf in millimetres",
                                        "default": 35
                                      }
                                    }
                                  },
                                  {
                                    "type": "object",
                                    "required": ["type"],
                                    "unevaluatedProperties": false,
                                    "properties": { "type": { "const": "StandardWindow" } }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "rooms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "walls"],
                    "unevaluatedProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "walls": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "unevaluatedProperties": false,
                          "properties": { "ref": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "Position of an object relative to its parent, in millimetres. The first element is the x-coordinate (higher toward the right when viewed on-screen), and the second element is the y-coordinate (higher downwards when viewed on-screen)."
    }
  }
}
