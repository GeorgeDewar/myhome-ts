{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myhome.dewar.co.nz/myhome.schema.json",
  "title": "Property",
  "description": "A property, including its buildings, fences, and other structures",
  "type": "object",
  "unevaluatedProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "georeference": {
      "type": "object",
      "description": "Geographic position of the plan origin and clockwise bearing of the plan's upward axis from true north",
      "required": ["latitude", "longitude", "bearing"],
      "unevaluatedProperties": false,
      "properties": {
        "latitude": { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "bearing": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "colours": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Definition of a colour that can be referenced by items in the plan",
        "required": ["id", "name", "value"],
        "unevaluatedProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Unique identifier for the colour, used internally to reference it" },
          "name": {
            "type": "string",
            "description": "Display name of the colour. It is not required to be unique.",
            "examples": ["Fence Brown"]
          },
          "description": {
            "type": "string",
            "description": "Description of the colour and its intended use",
            "examples": ["Used as the wall colour in most rooms"]
          },
          "value": { "type": "string", "description": "Hexadecimal value of the colour" }
        }
      }
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "fences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end"],
        "unevaluatedProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": {
            "$ref": "#/$defs/position",
            "description": "Position of the start of the fence (left side when viewing face A) relative to the ground, in millimetres. The position is midway through the thickness of the fence."
          },
          "end": {
            "$ref": "#/$defs/position",
            "description": "Position of the end of the fence (right side when viewing face A) relative to the ground, in millimetres. The position is midway through the thickness of the fence."
          },
          "width": { "type": "number", "exclusiveMinimum": 0, "description": "Width of the fence in millimetres" },
          "height": { "type": "number", "exclusiveMinimum": 0, "description": "Height of the fence in millimetres" }
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "levels"],
        "unevaluatedProperties": false,
        "properties": {
          "name": { "type": "string" },
          "defaults": { "$ref": "#/$defs/defaults" },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["number", "name"],
              "unevaluatedProperties": false,
              "properties": {
                "number": { "type": "integer", "description": "Floor number, starting from 0 for the ground floor" },
                "name": { "type": "string", "description": "Displayable name of the floor" },
                "defaults": { "$ref": "#/$defs/defaults" },
                "totalHeight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Height of the floor in millimetres, from the unfinished floor surface to the unfinished floor surface above"
                },
                "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" } },
                "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2,
      "description": "Position of an object relative to its parent, in millimetres. The first element is the x-coordinate (higher toward the right when viewed on-screen), and the second element is the y-coordinate (higher downwards when viewed on-screen)."
    },
    "wall": {
      "type": "object",
      "required": ["id", "start", "end"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start": {
          "$ref": "#/$defs/position",
          "description": "Position of the start of the wall (left side when viewing face A) relative to the floor, in millimetres. The position is midway through the thickness of the wall."
        },
        "end": {
          "$ref": "#/$defs/position",
          "description": "Position of the end of the wall (right side when viewing face A) relative to the floor, in millimetres. The position is midway through the thickness of the wall."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the wall in millimetres. Overrides defaults.wall.width."
        },
        "faceA": {
          "$ref": "#/$defs/wallFace",
          "description": "Overrides for face A of the wall (the face viewed with the start of the wall on the left)"
        },
        "faceB": { "$ref": "#/$defs/wallFace", "description": "Overrides for face B of the wall (the opposite face to face A)" },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "width", "distanceAlongWall"],
            "unevaluatedProperties": false,
            "properties": {
              "id": { "type": "string" },
              "shape": { "type": "string", "enum": ["rectangle", "halfCircleArch"], "default": "rectangle" },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Width of the door (the opening) in millimetres"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Height of the door (the opening) in millimetres"
              },
              "distanceAlongWall": {
                "type": "integer",
                "description": "Position of the center of the door along the wall, in millimetres. The position is measured from the start of the wall."
              },
              "distanceFromFloor": {
                "type": "integer",
                "description": "Distance of the bottom of the door from the floor, in millimetres.",
                "default": 0
              },
              "faceA": {
                "$ref": "#/$defs/openingFace",
                "description": "Overrides for the face A side of the opening, as for the wall it is in"
              },
              "faceB": {
                "$ref": "#/$defs/openingFace",
                "description": "Overrides for the face B side of the opening, as for the wall it is in"
              },
              "contents": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["type", "hingeSide", "swingDirection"],
                      "unevaluatedProperties": false,
                      "properties": {
                        "type": { "const": "StandardDoor" },
                        "x": { "type": "integer", "minimum": 0 },
                        "y": { "type": "integer", "minimum": 0 },
                        "width": { "type": "number", "exclusiveMinimum": 0 },
                        "height": { "type": "number", "exclusiveMinimum": 0 },
                        "openAngle": { "type": "number", "minimum": 0, "maximum": 180, "default": 90 },
                        "hingeSide": {
                          "type": "string",
                          "enum": ["left", "right"],
                          "description": "Which side of the door is hinged, as viewed from the A-side of the wall the door is installed in"
                        },
                        "swingDirection": {
                          "type": "string",
                          "enum": ["in", "out"],
                          "description": "Direction the door swings when opening, viewed from the A-side of the wall the door is installed in (in being toward the observer)"
                        }
                      },
                      "allOf": [{ "$ref": "#/$defs/doorProperties" }]
                    },
                    {
                      "type": "object",
                      "required": ["type"],
                      "unevaluatedProperties": false,
                      "properties": {
                        "type": { "const": "SlidingDoor" },
                        "x": { "type": "integer", "minimum": 0 },
                        "y": { "type": "integer", "minimum": 0 },
                        "width": { "type": "number", "exclusiveMinimum": 0 },
                        "height": { "type": "number", "exclusiveMinimum": 0 }
                      },
                      "allOf": [{ "$ref": "#/$defs/doorProperties" }]
                    },
                    {
                      "type": "object",
                      "required": ["type", "windowType"],
                      "unevaluatedProperties": false,
                      "properties": {
                        "type": { "const": "Window" },
                        "windowType": {
                          "type": "string",
                          "enum": ["awning", "fixed", "direct"],
                          "description": "Type of window"
                        },
                        "x": { "type": "integer", "minimum": 0 },
                        "y": { "type": "integer", "minimum": 0 },
                        "width": { "type": "number", "exclusiveMinimum": 0 },
                        "height": { "type": "number", "exclusiveMinimum": 0 }
                      },
                      "allOf": [
                        { "$ref": "#/$defs/windowProperties" },
                        {
                          "if": { "properties": { "windowType": { "const": "direct" } }, "required": ["windowType"] },
                          "then": { "not": { "required": ["sash"] } }
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "required": ["type"],
                      "unevaluatedProperties": false,
                      "properties": {
                        "type": { "const": "Post" },
                        "x": { "type": "integer", "minimum": 0 },
                        "y": { "type": "integer", "minimum": 0 },
                        "width": { "type": "number", "exclusiveMinimum": 0 },
                        "height": { "type": "number", "exclusiveMinimum": 0 }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "virtual": {
          "type": "boolean",
          "description": "If true, it's not really a wall at all but is only used to define an area"
        },
        "attic": {
          "type": "boolean",
          "description": "If true, this wall is classified by Home Designer as an attic wall"
        }
      }
    },
    "room": {
      "type": "object",
      "required": ["name", "walls"],
      "unevaluatedProperties": false,
      "properties": {
        "name": { "type": "string" },
        "defaults": { "$ref": "#/$defs/roomDefaults" },
        "label": {
          "type": "object",
          "description": "Label information for the room",
          "unevaluatedProperties": false,
          "properties": {
            "text": { "type": "string", "description": "Label text, defaulting to the room name" },
            "position": {
              "$ref": "#/$defs/position",
              "description": "Position of the room label center within the plan, in millimetres"
            },
            "rotation": {
              "type": "number",
              "description": "Rotation of the room label in degrees (anticlockwise)",
              "default": 0
            },
            "fontSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Font size of the room label in millimetres"
            }
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "unevaluatedProperties": false,
            "properties": { "ref": { "type": "string" } }
          }
        }
      }
    },
    "colourRef": {
      "type": "string",
      "description": "The id of a colour defined in the plan's colours"
    },
    "colourProperties": {
      "type": "object",
      "properties": { "colour": { "$ref": "#/$defs/colourRef" } }
    },
    "ceilingProperties": {
      "type": "object",
      "properties": {
        "colour": { "$ref": "#/$defs/colourRef" },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Height of the ceiling in millimetres, from the unfinished floor surface to the ceiling surface above"
        }
      }
    },
    "trimProperties": {
      "type": "object",
      "properties": {
        "colour": { "$ref": "#/$defs/colourRef" },
        "sillColour": {
          "$ref": "#/$defs/colourRef",
          "description": "Colour of sills. If not set at a given level of the hierarchy, the trim colour at that level applies."
        }
      }
    },
    "doorProperties": {
      "type": "object",
      "properties": {
        "colour": { "$ref": "#/$defs/colourRef" },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Thickness of the door leaf in millimetres",
          "default": 35
        }
      }
    },
    "windowProperties": {
      "type": "object",
      "properties": { "sash": { "$ref": "#/$defs/sash" } }
    },
    "wallProperties": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of walls in millimetres",
          "default": 100
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Default properties for items within this plan, building or level. A property that is not set on an item is taken from the nearest enclosing room, level, building or plan that sets it, in that order. Interior and exterior refer to the face of a wall that the item is on.",
      "unevaluatedProperties": false,
      "properties": {
        "interiorWall": { "$ref": "#/$defs/colourProperties", "unevaluatedProperties": false },
        "exteriorWall": { "$ref": "#/$defs/colourProperties", "unevaluatedProperties": false },
        "wall": { "$ref": "#/$defs/wallProperties", "unevaluatedProperties": false },
        "ceiling": { "$ref": "#/$defs/ceilingProperties", "unevaluatedProperties": false },
        "roof": { "$ref": "#/$defs/colourProperties", "unevaluatedProperties": false },
        "interiorDoor": { "$ref": "#/$defs/doorProperties", "unevaluatedProperties": false },
        "exteriorDoor": { "$ref": "#/$defs/doorProperties", "unevaluatedProperties": false },
        "interiorTrim": { "$ref": "#/$defs/trimProperties", "unevaluatedProperties": false },
        "exteriorTrim": { "$ref": "#/$defs/trimProperties", "unevaluatedProperties": false },
        "window": { "$ref": "#/$defs/windowProperties", "unevaluatedProperties": false }
      }
    },
    "roomDefaults": {
      "type": "object",
      "description": "Default properties for items within a room. Only properties that can differ from room to room are available. As the ceiling height is set by the level, only its colour can be set here.",
      "unevaluatedProperties": false,
      "properties": {
        "interiorWall": { "$ref": "#/$defs/colourProperties", "unevaluatedProperties": false },
        "ceiling": { "$ref": "#/$defs/colourProperties", "unevaluatedProperties": false },
        "interiorTrim": { "$ref": "#/$defs/trimProperties", "unevaluatedProperties": false }
      }
    },
    "wallFace": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "exterior": {
          "type": "boolean",
          "description": "Overrides whether this face is exterior. By default it is exterior if no room lies against it."
        },
        "colour": { "$ref": "#/$defs/colourRef", "description": "Colour of this face of the wall" }
      }
    },
    "openingFace": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "trim": {
          "$ref": "#/$defs/trimProperties",
          "unevaluatedProperties": false,
          "description": "Trim around the opening on this side"
        }
      }
    },
    "sash": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "widthTop": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the sash in millimetres (parallel to the glass)",
          "default": 35
        },
        "widthRight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the sash in millimetres (parallel to the glass)",
          "default": 35
        },
        "widthBottom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the sash in millimetres (parallel to the glass)",
          "default": 35
        },
        "widthLeft": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the sash in millimetres (parallel to the glass)",
          "default": 35
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Depth of the sash in millimetres (perpendicular to the glass)",
          "default": 35
        }
      }
    }
  }
}
